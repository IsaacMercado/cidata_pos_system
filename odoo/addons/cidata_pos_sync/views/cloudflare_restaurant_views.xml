<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Restaurante -->
    <record id="action_cloudflare_restaurant" model="ir.actions.act_window">
        <field name="name">Restaurantes</field>
        <field name="res_model">cloudflare.restaurant</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_cloudflare_restaurant_tree" model="ir.ui.view">
        <field name="name">cloudflare.restaurant.tree</field>
        <field name="model">cloudflare.restaurant</field>
        <field name="arch" type="xml">
            <list>
                <field name="cf_id" string="ID CF"/>
                <field name="name"/>
                <field name="is_active"/>
                <field name="table_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_cloudflare_restaurant_form" model="ir.ui.view">
        <field name="name">cloudflare.restaurant.form</field>
        <field name="model">cloudflare.restaurant</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nombre del restaurante"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="cf_id"/>
                            <field name="is_active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Mesas" name="tables">
                            <field name="table_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Mesa -->
    <record id="action_cloudflare_table" model="ir.actions.act_window">
        <field name="name">Mesas</field>
        <field name="res_model">cloudflare.table</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_cloudflare_table_tree" model="ir.ui.view">
        <field name="name">cloudflare.table.tree</field>
        <field name="model">cloudflare.table</field>
        <field name="arch" type="xml">
            <list>
                <field name="cf_id" string="ID CF"/>
                <field name="restaurant_id"/>
                <field name="name"/>
                <field name="capacity"/>
                <field name="status"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <record id="view_cloudflare_table_form" model="ir.ui.view">
        <field name="name">cloudflare.table.form</field>
        <field name="model">cloudflare.table</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nombre de la mesa"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="cf_id"/>
                            <field name="restaurant_id"/>
                            <field name="capacity"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="is_active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Reserva -->
    <record id="view_cloudflare_reservation_search" model="ir.ui.view">
        <field name="name">cloudflare.reservation.search</field>
        <field name="model">cloudflare.reservation</field>
        <field name="arch" type="xml">
            <search>
                <field name="guest_name"/>
                <field name="product_id"/>
                <field name="pos_order_id"/>
                <separator/>
                <filter string="Pendientes" name="pending" domain="[('state','=','pending')]"/>
                <filter string="Confirmadas" name="confirmed" domain="[('state','=','confirmed')]"/>
                <filter string="Check-in" name="checked_in" domain="[('state','=','checked_in')]"/>
                <filter string="Agrupar por estado" name="group_state" context="{'group_by':'state'}"/>
                <filter string="Agrupar por producto" name="group_product" context="{'group_by':'product_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_cloudflare_reservation_tree" model="ir.ui.view">
        <field name="name">cloudflare.reservation.tree</field>
        <field name="model">cloudflare.reservation</field>
        <field name="arch" type="xml">
            <list decoration-info="state=='pending'" decoration-success="state=='confirmed'">
                <field name="product_id"/>
                <field name="guest_name"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="nights"/>
                <field name="guests"/>
                <field name="total"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_cloudflare_reservation_form" model="ir.ui.view">
        <field name="name">cloudflare.reservation.form</field>
        <field name="model">cloudflare.reservation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirmar"
                            invisible="state != 'pending'" class="oe_highlight"/>
                    <button name="action_checkin" type="object" string="Check-in"
                            invisible="state != 'confirmed'" class="oe_highlight"/>
                    <button name="action_checkout" type="object" string="Check-out"
                            invisible="state != 'checked_in'" class="oe_highlight"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="product_id" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="cf_id"/>
                            <field name="guest_name"/>
                            <field name="pos_order_id"/>
                        </group>
                        <group>
                            <field name="check_in"/>
                            <field name="check_out"/>
                            <field name="nights"/>
                            <field name="guests"/>
                            <field name="guest_price"/>
                            <field name="total"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cloudflare_reservation" model="ir.actions.act_window">
        <field name="name">Reservas</field>
        <field name="res_model">cloudflare.reservation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cloudflare_reservation_search"/>
    </record>

    <record id="action_cloudflare_reservation_rate" model="ir.actions.act_window">
        <field name="name">Tarifas de reserva</field>
        <field name="res_model">cloudflare.reservation.rate</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_cloudflare_reservation_rate_tree" model="ir.ui.view">
        <field name="name">cloudflare.reservation.rate.tree</field>
        <field name="model">cloudflare.reservation.rate</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="product_id"/>
                <field name="guests"/>
                <field name="price"/>
            </list>
        </field>
    </record>
</odoo>
