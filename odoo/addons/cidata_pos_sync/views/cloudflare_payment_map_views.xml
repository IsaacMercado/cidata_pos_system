<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cloudflare_payment_map_list" model="ir.ui.view">
        <field name="name">cloudflare.payment.map.list</field>
        <field name="model">cloudflare.payment.map</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-danger="not payment_method_id">
                <field name="cloudflare_code"/>
                <field name="cloudflare_name"/>
                <field name="payment_method_id"/>
                <field name="company_id" groups="base.group_multi_company" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="action_cloudflare_payment_map" model="ir.actions.act_window">
        <field name="name">Mapeo de métodos de pago</field>
        <field name="res_model">cloudflare.payment.map</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Descarga el catálogo para autocompletar los códigos del POS.
            </p>
            <p>
                Cada código de método de pago del POS (cash, card, mobile, transfer)
                debe mapearse a un método de pago de Odoo antes de sincronizar ventas.
            </p>
        </field>
    </record>
</odoo>
