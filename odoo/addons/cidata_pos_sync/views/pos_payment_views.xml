<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_payment_form_inherit_cidata" model="ir.ui.view">
        <field name="name">pos.payment.form.inherit.cidata_pos_sync</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <field name="cf_currency" invisible="not cf_currency"/>
                <field name="cf_amount_original" invisible="not cf_amount_original" widget="monetary"/>
                <field name="cf_exchange_rate" invisible="not cf_exchange_rate"/>
                <field name="cf_phone" invisible="not cf_phone"/>
            </xpath>
        </field>
    </record>
</odoo>
