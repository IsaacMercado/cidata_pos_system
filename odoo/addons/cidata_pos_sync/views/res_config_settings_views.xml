<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_cidata" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.cidata_pos_sync</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Cloudflare POS Sync" string="Cloudflare POS Sync" name="cidata_pos_sync">
                    <block title="Conexión con el Worker Cloudflare">
                        <setting string="URL del Worker">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="cf_worker_url" class="col-lg-3 o_light_label"/>
                                    <field name="cf_worker_url" placeholder="https://pos.ejemplo.workers.dev"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Token de integración" help="Token de servicio configurado como INTEGRATION_TOKEN en el Worker. Se envía en el encabezado Authorization: Bearer.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="cf_integration_token" class="col-lg-3 o_light_label"/>
                                    <field name="cf_integration_token" password="True"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Sesión y destino">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="cf_pos_config_id" class="col-lg-3 o_light_label"/>
                                    <field name="cf_pos_config_id"/>
                                </div>
                                <div class="row mt16">
                                    <label for="cf_auto_open_session" class="col-lg-3 o_light_label"/>
                                    <field name="cf_auto_open_session"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
